# Get a key at https://aistudio.google.com/apikey — never commit the real one.
GEMINI_API_KEY=

# Live (realtime voice) model. Run `npm run models -w server` to list what your key can use.
GEMINI_LIVE_MODEL=gemini-3.8-live

# Prebuilt voice: Puck (upbeat), Kore, Aoede, Charon, Fenrir, Leda, Orus, Zephyr ...
GEMINI_VOICE=Puck

PORT=8787

# Comma-separated origins allowed to request voice tokens. Empty = localhost only.
ALLOWED_ORIGINS=
