{
  "manifest_version": 3,
  "name": "Tekkie",
  "version": "0.1.0",
  "description": "A 3D AI buddy that floats over every page and talks with you in real time.",
  "key": "",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Tekkie",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "offscreen",
    "debugger",
    "tabs",
    "activeTab",
    "scripting",
    "contextMenus",
    "alarms",
    "notifications",
    "downloads",
    "history",
    "bookmarks",
    "unlimitedStorage",
    "clipboardWrite"
  ],
  "commands": {
    "toggle-talk": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "Start or stop talking to Tekkie"
    },
    "toggle-tekkie": {
      "suggested_key": {
        "default": "Alt+Shift+H"
      },
      "description": "Show or hide Tekkie"
    }
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
